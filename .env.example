# Copy to .env at the repo root and fill in. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO
# true for JSON logs (deployed), false for readable console logs (local)
LOG_JSON=false
# JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:5173"]

# Local Docker Postgres. For Neon use:
# postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support_desk

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model names. Check the Groq console, the list changes often.
MODEL_SMALL=openai/gpt-oss-20b
MODEL_LARGE=openai/gpt-oss-120b
MODEL_STT=whisper-large-v3-turbo
# gpt-oss models reason before answering. Leave empty for non-reasoning models.
REASONING_EFFORT=low
# Free-tier limits per model tier. This key also has a cap of 1,000 requests per day per model.
SMALL_RPM=30
SMALL_TPM=8000
LARGE_RPM=30
LARGE_TPM=8000
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30
LLM_CACHE_ENABLED=true

# Shared secret for the GitHub Actions weekly trigger
WEEKLY_TRIGGER_TOKEN=

# Existing MCP server (Phase 5). Google token limited to Docs + gmail.compose.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DOC_ID=
# Optional: the server is started as `node dist/index.js` in MCP_SERVER_DIR (default:
# mcp_server/ in this repo). Build it first: cd mcp_server && npm ci && npm run build
MCP_SERVER_COMMAND=
